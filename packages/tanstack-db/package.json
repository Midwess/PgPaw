{
  "name": "@pgpaw/tanstack-db",
  "version": "0.1.0",
  "description": "Native TanStack DB collection for PgPaw live sync (full SQL, RLS, optimistic writes confirmed by transaction id)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "pgpaw",
    "tanstack",
    "tanstack-db",
    "postgres",
    "sync",
    "realtime"
  ],
  "peerDependencies": {
    "@tanstack/db": ">=0.6.0"
  },
  "devDependencies": {
    "@tanstack/db": "^0.6.8",
    "tsup": "^8.5.1",
    "typescript": "^5.7.0",
    "vitest": "^4.1.9"
  }
}
